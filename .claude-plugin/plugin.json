{
  "name": "total-agent-memory",
  "description": "Persistent local memory for Claude Code — temporal knowledge graph, procedural memory, AST codebase ingest, cross-project analogy. Installs the MCP server, the memory-protocol skill and the capture hooks in one step.",
  "version": "15.0.2",
  "author": {
    "name": "Vitalii Cherepanov",
    "url": "https://github.com/vbcherepanov"
  },
  "homepage": "https://totalmemory.dev",
  "repository": "https://github.com/vbcherepanov/total-agent-memory",
  "license": "MIT",
  "keywords": [
    "memory",
    "mcp",
    "knowledge-graph",
    "local-first",
    "context",
    "recall"
  ],
  "mcpServers": {
    "memory": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/tam_plugin_bootstrap.py"
      ],
      "env": {
        "MEMORY_MODE": "fast",
        "MEMORY_ASYNC_ENRICHMENT": "true"
      }
    }
  }
}
